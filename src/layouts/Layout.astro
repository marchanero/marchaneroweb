---
// Importaciones
import ThemeToggle from '../components/ThemeToggle.astro';
import SignalTrace from '../components/SignalTrace.astro';
import JsonLd from '../components/JsonLd.astro';
import BackToTop from '../components/BackToTop.astro';
// Fuentes autoalojadas (@fontsource): evita el @import a fonts.googleapis.com,
// que forzaba 2 orígenes externos adicionales bloqueando el renderizado del texto.
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import ibmPlexSans400Woff2 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';

// Props
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Web personal de Roberto Sánchez Reolid | Investigador en UCLM" } = Astro.props;

// Obtener la URL actual para marcar el enlace activo en la navegación
const currentPath = Astro.url.pathname;

const navItems = [
	{
		href: '/',
		label: 'Inicio',
		match: (p: string) => p === '/',
		icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
	},
	{
		href: '/sobre-mi',
		label: 'Sobre mí',
		match: (p: string) => p.includes('/sobre-mi'),
		icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
	},
	{
		href: '/cv',
		label: 'CV',
		match: (p: string) => p.includes('/cv'),
		icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
	},
	{
		href: '/publicaciones',
		label: 'Publicaciones',
		match: (p: string) => p.includes('/publicaciones'),
		icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
	},
	{
		href: '/proyectos',
		label: 'Proyectos',
		match: (p: string) => p.includes('/proyectos'),
		icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
	},
	{
		href: '/asignaturas',
		label: 'Docencia',
		match: (p: string) => p.includes('/asignaturas'),
		icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
	},
	{
		href: '/contacto',
		label: 'Contacto',
		match: (p: string) => p.includes('/contacto'),
		icon: 'M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#0B1220" />
		<meta name="generator" content={Astro.generator} />
		<!-- Preload de la fuente de texto principal para evitar FOUT/CLS en el primer render -->
		<link rel="preload" as="font" type="font/woff2" href={ibmPlexSans400Woff2} crossorigin />
		<link rel="canonical" href={new URL(currentPath, Astro.site)} />
		<title>{title}</title>
		<!-- SEO y Social Media -->
		<meta name="author" content="Roberto Sánchez Reolid" />
		<meta name="keywords" content="Roberto Sánchez Reolid, investigación, UCLM, Universidad Castilla-La Mancha, Inteligencia Artificial y procesamiento de señales fisiológicas" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://marchanero.netlify.app/og-default.png" />
		<meta property="og:image" content="https://marchanero.netlify.app/og-default.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<JsonLd />

		<!-- Script para asegurar que no haya flash de modo incorrecto -->
		<script is:inline src="/scripts/theme-init.js"></script>
	</head>
	<body class="bg-paper dark:bg-ink text-graphite-700 dark:text-graphite-100 min-h-screen flex flex-col">
		<a href="#main-content" class="skip-link">Saltar al contenido principal</a>
		<header class="bg-paper/95 dark:bg-ink/95 backdrop-blur-sm border-b border-line dark:border-line-dark sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<nav class="flex items-center justify-between py-3">
					<a href="/" class="flex items-center gap-2.5 group">
						<span class="w-9 h-5 text-signal-500 dark:text-signal-400">
							<SignalTrace variant="ecg" width={80} height={40} beats={1} strokeWidth={3} animate={false} />
						</span>
						<span class="font-display font-bold text-graphite-800 dark:text-white group-hover:text-pulse-700 dark:group-hover:text-pulse-400 transition-colors">
							Dr. Roberto Sánchez Reolid
						</span>
					</a>

					<!-- Navegación para pantallas medianas y grandes -->
					<div class="hidden md:flex items-center gap-1">
						<ul class="flex items-center gap-1">
							{navItems.map((item) => (
								<li>
									<a
										href={item.href}
										class:list={[
											'flex items-center gap-2 px-3 py-2 text-sm border-b-2 transition-colors duration-200',
											item.match(currentPath)
												? 'border-pulse-500 text-pulse-700 dark:text-pulse-400 font-medium'
												: 'border-transparent text-graphite-600 dark:text-graphite-300 hover:text-pulse-700 dark:hover:text-pulse-400 hover:border-line dark:hover:border-line-dark',
										]}
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>

						<div class="ml-4 pl-4 border-l border-line dark:border-line-dark">
							<ThemeToggle />
						</div>
					</div>

					<!-- Menú móvil (hamburguesa) -->
					<div class="md:hidden flex items-center gap-3">
						<ThemeToggle />
						<button id="mobile-menu-button" aria-label="Menú" aria-expanded="false" class="p-2 rounded-md border border-line dark:border-line-dark text-graphite-600 dark:text-graphite-300">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
							</svg>
						</button>
					</div>
				</nav>

				<!-- Menú móvil desplegable -->
				<div id="mobile-menu" class="hidden md:hidden py-2 border-t border-line dark:border-line-dark">
					<div class="space-y-1">
						{navItems.map((item) => (
							<a
								href={item.href}
								class:list={[
									'flex items-center gap-3 px-3 py-2.5 rounded-md text-sm transition-colors duration-200',
									item.match(currentPath)
										? 'font-medium text-pulse-700 dark:text-pulse-400 bg-pulse-50 dark:bg-pulse-500/10'
										: 'text-graphite-600 dark:text-graphite-300 hover:bg-graphite-50 dark:hover:bg-graphite-800',
								]}
							>
								{item.label}
							</a>
						))}
					</div>
				</div>
			</div>
		</header>

		<main id="main-content" class="flex-grow">
			<slot />
		</main>

		<footer class="mt-auto bg-paper dark:bg-ink border-t border-line dark:border-line-dark">
			<BackToTop />
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
				<div class="flex flex-col md:flex-row justify-between items-center gap-4">
					<div class="text-center md:text-left">
						<p class="font-display font-medium text-graphite-800 dark:text-white">
							Dr. Roberto Sánchez Reolid
						</p>
						<p class="text-sm text-graphite-500 dark:text-graphite-400 mt-0.5">
							&copy; {new Date().getFullYear()} · Todos los derechos reservados
						</p>
					</div>

					<div class="flex flex-col md:flex-row items-center gap-3 md:gap-6">
						<div class="flex items-center gap-2 text-graphite-500 dark:text-graphite-400 text-sm">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
							</svg>
							<span>Universidad de Castilla-La Mancha</span>
						</div>

						<div class="flex gap-4">
							<a href="https://scholar.google.com/citations?user=PCALePwAAAAJ" target="_blank" rel="noopener noreferrer"
							   class="text-graphite-400 hover:text-pulse-500 transition-colors"
							   title="Google Scholar">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5 12 0z"/>
								</svg>
							</a>
							<a href="https://orcid.org/0000-0003-4455-370X" target="_blank" rel="noopener noreferrer"
							   class="text-graphite-400 hover:text-pulse-500 transition-colors"
							   title="ORCID">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947 0 .525-.422.947-.947.947A.95.95 0 0 1 6.422 5.325c0-.516.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 3.588-1.444 3.588-3.722 0-2.016-1.091-3.722-3.588-3.722h-2.297z"/>
								</svg>
							</a>
							<a href="https://www.researchgate.net/profile/Roberto-Sanchez-Reolid" target="_blank" rel="noopener noreferrer"
							   class="text-graphite-400 hover:text-pulse-500 transition-colors"
							   title="ResearchGate">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M19.586 0c-.818 0-1.508.19-2.073.565-.563.377-.97.936-1.213 1.68a3.193 3.193 0 0 0-.112.437 8.365 8.365 0 0 0-.078.53 9.284 9.284 0 0 0-.05.727c-.01.282-.013.621-.013 1.016a31.121 31.121 0 0 0 .014 1.017 9.289 9.289 0 0 0 .05.727 7.946 7.946 0 0 0 .078.53 3.995 3.995 0 0 0 .112.437c.244.744.65 1.303 1.213 1.68.565.375 1.255.565 2.073.565.818 0 1.508-.19 2.073-.565.563-.377.97-.936 1.213-1.68a3.193 3.193 0 0 0 .112-.437 8.365 8.365 0 0 0 .078-.53 9.284 9.284 0 0 0 .05-.727c.01-.282.013-.621.013-1.016a31.121 31.121 0 0 0-.014-1.017 9.289 9.289 0 0 0-.05-.727 7.946 7.946 0 0 0-.078-.53 3.995 3.995 0 0 0-.112-.437c-.244-.744-.65-1.303-1.213-1.68C21.094.19 20.404 0 19.586 0z"/>
								</svg>
							</a>
							<a href="https://linkedin.com/in/roberto-sanchez-reolid" target="_blank" rel="noopener noreferrer"
							   class="text-graphite-400 hover:text-pulse-500 transition-colors"
							   title="LinkedIn">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
								</svg>
							</a>
						</div>
					</div>
				</div>

				<div class="mt-6 pt-6 border-t border-line dark:border-line-dark text-center md:text-left">
					<p class="font-mono text-xs text-graphite-400 dark:text-graphite-500">
						Diseño y desarrollo propios · Astro · Modo oscuro
					</p>
				</div>
			</div>
		</footer>

		<script is:inline src="/scripts/site.js"></script>
	</body>
</html>
