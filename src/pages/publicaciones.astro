---
// Importar layout y datos de Google Scholar
import Layout from '../layouts/Layout.astro';
import ScholarMetrics from '../components/ScholarMetrics.astro';
import scholarData from '../data/scholar.json';

// Configuración de la página
export const title = 'Publicaciones - Dr. Roberto Sánchez Reolid';
export const description = 'Publicaciones científicas y métricas bibliométricas del Dr. Roberto Sánchez Reolid, Universidad de Castilla-La Mancha';

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

function getPublicationType(publication: { publication?: string }) {
  const venue = (publication.publication || '').toLowerCase();
  if (venue.includes('journal') || venue.includes('ieee') || venue.includes('acm')) return 'journal';
  if (venue.includes('conference') || venue.includes('proceedings')) return 'conference';
  if (venue.includes('book')) return 'book';
  return 'article';
}

function getPublicationLabel(type: string) {
  switch (type) {
    case 'journal': return 'Revista';
    case 'conference': return 'Conferencia';
    case 'book': return 'Libro';
    default: return 'Artículo';
  }
}

const uniqueYears = [...new Set(scholarData.publications.map(pub => pub.year).filter(Boolean))].sort((a, b) => parseInt(b as any) - parseInt(a as any));
---

<Layout title={title} description={description}>
  <!-- Header -->
  <header class="relative border-b border-line dark:border-line-dark py-14 sm:py-20 hero-wash overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="eyebrow mb-3">Google Scholar</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-graphite-900 dark:text-white mb-4">
        Publicaciones científicas
      </h1>
      <p class="text-lg text-graphite-600 dark:text-graphite-300 max-w-2xl leading-relaxed mb-8">
        Investigación en Inteligencia Artificial, Machine Learning y computación afectiva.
      </p>

      <div class="readout max-w-2xl">
        <div class="readout-cell">
          <div class="readout-value">{scholarData.metrics.totalCitations}</div>
          <div class="readout-label">Citas</div>
        </div>
        <div class="readout-cell">
          <div class="readout-value">{scholarData.publications.length}</div>
          <div class="readout-label">Publicaciones</div>
        </div>
        <div class="readout-cell">
          <div class="readout-value">{scholarData.metrics.hIndex}</div>
          <div class="readout-label">h-index</div>
        </div>
        <div class="readout-cell">
          <div class="readout-value">{scholarData.metrics.i10Index}</div>
          <div class="readout-label">i10-index</div>
        </div>
      </div>

      <p class="mt-4 font-mono text-xs text-graphite-400 dark:text-graphite-500">
        Última actualización: {formatDate(scholarData.lastUpdated)}
      </p>
    </div>
  </header>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <!-- Métricas bibliométricas -->
    <section class="mb-12 reveal">
      <ScholarMetrics showDetails={true} />
    </section>

    <!-- Información del perfil -->
    <section class="mb-12 reveal">
      <div class="spec-card p-8">
        <span class="spec-tick spec-tick-tl"></span>
        <span class="spec-tick spec-tick-br"></span>
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div>
            <h2 class="text-xl font-display font-bold text-graphite-900 dark:text-white mb-1">
              {scholarData.author.name}
            </h2>
            <p class="text-graphite-500 dark:text-graphite-400 mb-4">
              {scholarData.author.affiliation}
            </p>
            <div class="flex flex-wrap gap-2">
              {scholarData.author.interests.map((interest) => (
                <span class="border border-line dark:border-line-dark text-graphite-600 dark:text-graphite-300 px-3 py-1 rounded-md text-xs font-mono">
                  {interest.title}
                </span>
              ))}
            </div>
          </div>
          <a href={`mailto:${scholarData.author.email}`} class="btn btn-primary shrink-0">
            Contactar
          </a>
        </div>
      </div>
    </section>

    <!-- Lista de publicaciones -->
    <section class="reveal">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white">
          Publicaciones <span class="font-mono text-graphite-400 dark:text-graphite-500 text-xl">({scholarData.publications.length})</span>
        </h2>

        <div class="flex flex-wrap gap-3">
          <select
            id="sortOrder"
            class="px-4 py-2 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-700 dark:text-graphite-200 font-mono text-sm focus:outline-none focus:border-pulse-500"
          >
            <option value="citations-desc">Más citadas</option>
            <option value="year-desc">Más recientes</option>
          </select>

          <select
            id="yearFilter"
            class="px-4 py-2 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-700 dark:text-graphite-200 font-mono text-sm focus:outline-none focus:border-pulse-500"
          >
            <option value="">Todos los años</option>
            {uniqueYears.map(year => (
              <option value={year}>{year}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="space-y-4" id="publicationsList">
        {scholarData.publications.map((publication) => {
          const pubType = getPublicationType(publication);
          return (
            <article
              class="spec-card publication-item"
              data-year={publication.year}
              data-type={pubType}
              data-citations={publication.citedBy ?? 0}
            >
              <span class="spec-tick spec-tick-tl"></span>
              <span class="spec-tick spec-tick-br"></span>
              <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
                <div class="flex-1">
                  <div class="flex flex-wrap items-center gap-3 mb-3 font-mono text-xs">
                    <span class="text-graphite-500 dark:text-graphite-400">{publication.year}</span>
                    <span class="text-graphite-300 dark:text-graphite-600">·</span>
                    <span class="text-pulse-600 dark:text-pulse-400 uppercase tracking-wide">{getPublicationLabel(pubType)}</span>
                  </div>

                  <h3 class="text-lg font-semibold text-graphite-900 dark:text-white mb-2 leading-snug">
                    {publication.link ? (
                      <a href={publication.link} target="_blank" rel="noopener noreferrer" class="hover:text-pulse-600 dark:hover:text-pulse-400">
                        {publication.title}
                      </a>
                    ) : (
                      publication.title
                    )}
                  </h3>

                  <p class="text-graphite-600 dark:text-graphite-300 text-sm mb-2">
                    {publication.authors}
                  </p>

                  <p class="text-graphite-500 dark:text-graphite-400 text-sm italic">
                    {publication.publication}
                  </p>
                </div>

                <div class="flex flex-row lg:flex-col items-center lg:items-stretch gap-4 shrink-0 lg:w-36">
                  <div class="border border-line dark:border-line-dark rounded-md px-4 py-3 text-center lg:text-right">
                    <div class="font-mono text-3xl font-medium leading-none text-graphite-800 dark:text-white">
                      {publication.citedBy ?? 0}
                    </div>
                    <div class="font-mono text-[0.65rem] uppercase tracking-wide text-graphite-500 dark:text-graphite-400 mt-1.5">
                      citas
                    </div>
                  </div>

                  <div class="flex flex-col gap-2">
                    {publication.link && (
                      <a href={publication.link} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
                        Ver publicación
                      </a>
                    )}
                    {publication.citedByLink && (
                      <a href={publication.citedByLink} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                        Ver citas
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Enlaces adicionales -->
    <section class="mt-16 text-center reveal">
      <div class="spec-card p-8">
        <span class="spec-tick spec-tick-tl"></span>
        <span class="spec-tick spec-tick-br"></span>
        <p class="eyebrow mb-2">Enlaces</p>
        <h3 class="text-xl font-display font-bold text-graphite-900 dark:text-white mb-6">
          Perfiles académicos
        </h3>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="https://scholar.google.com/citations?user=PCALePwAAAAJ" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            Google Scholar
          </a>
          <a href="https://orcid.org/0000-0003-4455-370X" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            ORCID
          </a>
          <a href="https://www.researchgate.net/profile/Roberto-Sanchez-Reolid" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            ResearchGate
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const yearFilter = document.getElementById('yearFilter') as HTMLSelectElement;
    const sortOrder = document.getElementById('sortOrder') as HTMLSelectElement;
    const publicationsList = document.getElementById('publicationsList');
    const publicationItems = document.querySelectorAll('.publication-item') as NodeListOf<HTMLElement>;

    function filterPublications() {
      if (!yearFilter) return;
      const selectedYear = yearFilter.value;

      publicationItems.forEach((item: HTMLElement) => {
        const match = !selectedYear || item.dataset.year === selectedYear;
        item.classList.toggle('hidden', !match);
      });
    }

    function sortPublications() {
      if (!sortOrder || !publicationsList) return;

      const items = Array.from(publicationItems);
      if (sortOrder.value === 'citations-desc') {
        items.sort((a, b) =>
          parseInt(b.dataset.citations || '0') - parseInt(a.dataset.citations || '0')
        );
      } else {
        // Orden original del JSON (Scholar: fecha de publicación descendente)
        items.sort((a, b) =>
          parseInt(b.dataset.year || '0') - parseInt(a.dataset.year || '0')
        );
      }

      items.forEach((item) => publicationsList.appendChild(item));
    }

    yearFilter?.addEventListener('change', filterPublications);
    sortOrder?.addEventListener('change', sortPublications);

    // Orden inicial: más citadas, todos los años
    sortPublications();
  });
</script>
