---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contacto | Roberto Sánchez Reolid"
	description="Contacta con el Dr. Roberto Sánchez Reolid para colaboraciones de investigación, consultas académicas o proyectos en Inteligencia Artificial."
>
	<!-- Header -->
	<header class="relative border-b border-line dark:border-line-dark py-10 sm:py-16 px-4 sm:px-6 lg:px-8 hero-wash overflow-hidden">
		<div class="max-w-4xl mx-auto text-center">
			<p class="eyebrow mb-3">Colaboración e investigación</p>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-graphite-900 dark:text-white mb-4">
				Contacto
			</h1>
			<p class="text-lg text-graphite-600 dark:text-graphite-300 max-w-2xl mx-auto leading-relaxed">
				¿Interesado en colaborar en proyectos de investigación o tienes alguna consulta académica?
				Escríbeme por el formulario o por alguno de los siguientes canales.
			</p>
		</div>
	</header>

	<div class="py-10 sm:py-16 px-4 sm:px-6 lg:px-8">
		<div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">
			<!-- Columna izquierda: información de contacto -->
			<div class="reveal space-y-6">
				<div class="spec-card p-8">
					<span class="spec-tick spec-tick-tl"></span>
					<span class="spec-tick spec-tick-br"></span>
					<p class="eyebrow mb-6">Canales de contacto</p>

					<div class="space-y-6">
						<div class="flex items-start gap-4">
							<div class="w-11 h-11 shrink-0 border border-line dark:border-line-dark rounded-md flex items-center justify-center text-signal-500 dark:text-signal-400">
								<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
									<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
									<polyline points="22,6 12,13 2,6"></polyline>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold text-graphite-900 dark:text-white mb-1">Email académico</h3>
								<a href="mailto:roberto.sanchez@uclm.es" class="text-pulse-700 dark:text-pulse-400 dark:hover:text-pulse-300 text-sm">roberto.sanchez@uclm.es</a>
							</div>
						</div>

						<div class="flex items-start gap-4">
							<div class="w-11 h-11 shrink-0 border border-line dark:border-line-dark rounded-md flex items-center justify-center text-signal-500 dark:text-signal-400">
								<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold text-graphite-900 dark:text-white mb-1">LinkedIn</h3>
								<a href="https://www.linkedin.com/in/roberto-sanchez-reolid-phd-19215b4a/" target="_blank" rel="noopener noreferrer" class="text-pulse-700 dark:text-pulse-400 dark:hover:text-pulse-300 text-sm">roberto-sanchez-reolid</a>
							</div>
						</div>

						<div class="flex items-start gap-4">
							<div class="w-11 h-11 shrink-0 border border-line dark:border-line-dark rounded-md flex items-center justify-center text-signal-500 dark:text-signal-400">
								<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947 0 .525-.422.947-.947.947-.525 0-.946-.422-.946-.947 0-.525.421-.947.946-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 3.688-1.575 3.688-3.722 0-2.016-1.247-3.722-3.688-3.722h-2.297z"/>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold text-graphite-900 dark:text-white mb-1">ORCID</h3>
								<a href="https://orcid.org/0000-0003-4455-370X" target="_blank" rel="noopener noreferrer" class="text-pulse-700 dark:text-pulse-400 dark:hover:text-pulse-300 text-sm">0000-0003-4455-370X</a>
							</div>
						</div>

						<div class="flex items-start gap-4">
							<div class="w-11 h-11 shrink-0 border border-line dark:border-line-dark rounded-md flex items-center justify-center text-signal-500 dark:text-signal-400">
								<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
									<path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
									<path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold text-graphite-900 dark:text-white mb-1">Ubicación</h3>
								<p class="text-sm text-graphite-500 dark:text-graphite-400 leading-relaxed">
									Facultad de Ciencias Sociales y Tecnologías de la Información<br />
									Universidad de Castilla-La Mancha<br />
									Edificio Margarita Salas · Despacho 3.3<br />
									Avda. Real Fábrica de Sedas, s/n · 45600 Talavera de la Reina (Toledo)
								</p>
							</div>
						</div>
					</div>
				</div>

				<div class="spec-card p-8">
					<span class="spec-tick spec-tick-tl"></span>
					<span class="spec-tick spec-tick-br"></span>
					<p class="eyebrow mb-4">Cómo llegar</p>
					<div
						id="location-map"
						class="w-full h-64 sm:h-72 rounded-md overflow-hidden border border-line dark:border-line-dark"
						role="img"
						aria-label="Mapa de ubicación de la Facultad de Ciencias Sociales y Tecnologías de la Información, Talavera de la Reina"
					>
						<noscript>
							<a href="https://www.openstreetmap.org/?mlat=39.9531&mlon=-4.8418#map=17/39.9531/-4.8418" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm m-4 inline-flex">
								Ver ubicación en OpenStreetMap ↗
							</a>
						</noscript>
					</div>
					<a
						href="https://www.openstreetmap.org/?mlat=39.9531&mlon=-4.8418#map=17/39.9531/-4.8418"
						target="_blank"
						rel="noopener noreferrer"
						class="mt-3 inline-block text-sm text-pulse-700 dark:text-pulse-400 dark:hover:text-pulse-300"
					>
						Ver mapa más grande ↗
					</a>
				</div>

				<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
				<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
				<script is:inline>
					(function () {
						function initMap() {
							var el = document.getElementById('location-map');
							if (!el || typeof L === 'undefined') return;
							el.removeAttribute('role');
							el.removeAttribute('aria-label');
							var map = L.map(el, { scrollWheelZoom: false }).setView([39.9531, -4.8418], 16);
							L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
								attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
								maxZoom: 19,
							}).addTo(map);
							L.marker([39.9531, -4.8418])
								.addTo(map)
								.bindPopup('Facultad de Ciencias Sociales y Tecnologías de la Información');
						}
						if (document.readyState === 'loading') {
							document.addEventListener('DOMContentLoaded', initMap);
						} else {
							initMap();
						}
					})();
				</script>

				<div class="spec-card p-8">
					<span class="spec-tick spec-tick-tl"></span>
					<span class="spec-tick spec-tick-br"></span>
					<p class="eyebrow mb-4">Disponibilidad</p>
					<dl class="space-y-3 text-sm">
						<div class="flex justify-between">
							<dt class="text-graphite-500 dark:text-graphite-400">Lunes – Viernes</dt>
							<dd class="font-mono text-graphite-800 dark:text-graphite-100">9:00 – 18:00</dd>
						</div>
						<div class="flex justify-between">
							<dt class="text-graphite-500 dark:text-graphite-400">Respuesta por email</dt>
							<dd class="font-mono text-graphite-800 dark:text-graphite-100">24–48 horas</dd>
						</div>
						<div class="flex justify-between">
							<dt class="text-graphite-500 dark:text-graphite-400">Reuniones</dt>
							<dd class="font-mono text-graphite-800 dark:text-graphite-100">Previa cita</dd>
						</div>
					</dl>
				</div>
			</div>

			<!-- Columna derecha: formulario -->
			<div class="reveal">
				<div class="spec-card p-8">
					<span class="spec-tick spec-tick-tl"></span>
					<span class="spec-tick spec-tick-br"></span>
					<p class="eyebrow mb-6">Formulario de contacto</p>

					<form class="space-y-5" name="contact" method="POST" data-netlify="true" id="contact-form">
						<input type="hidden" name="form-name" value="contact" />

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
							<div>
								<label for="name" class="block text-xs font-mono uppercase tracking-wide text-graphite-500 dark:text-graphite-400 mb-2">Nombre *</label>
								<input type="text" id="name" name="name" required
									class="w-full px-3 py-2.5 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-800 dark:text-white text-sm focus:outline-none focus:border-pulse-500" />
							</div>
							<div>
								<label for="email" class="block text-xs font-mono uppercase tracking-wide text-graphite-500 dark:text-graphite-400 mb-2">Email *</label>
								<input type="email" id="email" name="email" required
									class="w-full px-3 py-2.5 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-800 dark:text-white text-sm focus:outline-none focus:border-pulse-500" />
							</div>
						</div>

						<div>
							<label for="institution" class="block text-xs font-mono uppercase tracking-wide text-graphite-500 dark:text-graphite-400 mb-2">Institución</label>
							<input type="text" id="institution" name="institution"
								class="w-full px-3 py-2.5 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-800 dark:text-white text-sm focus:outline-none focus:border-pulse-500" />
						</div>

						<div>
							<label for="subject" class="block text-xs font-mono uppercase tracking-wide text-graphite-500 dark:text-graphite-400 mb-2">Asunto *</label>
							<select id="subject" name="subject" required
								class="w-full px-3 py-2.5 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-800 dark:text-white text-sm focus:outline-none focus:border-pulse-500">
								<option value="">Selecciona un asunto</option>
								<option value="colaboracion">Colaboración en investigación</option>
								<option value="consulta">Consulta académica</option>
								<option value="tutoria">Tutoría</option>
								<option value="supervision">Supervisión de tesis</option>
								<option value="revista">Revisión de artículos</option>
								<option value="conferencia">Conferencias / seminarios</option>
								<option value="otros">Otros</option>
							</select>
						</div>

						<div>
							<label for="message" class="block text-xs font-mono uppercase tracking-wide text-graphite-500 dark:text-graphite-400 mb-2">Mensaje *</label>
							<textarea id="message" name="message" rows="6" required
								placeholder="Describe brevemente el motivo de tu contacto..."
								class="w-full px-3 py-2.5 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-800 dark:text-white text-sm focus:outline-none focus:border-pulse-500 resize-none"></textarea>
						</div>

						<div class="flex items-start gap-2">
							<input type="checkbox" id="privacidad" name="privacidad" required class="mt-1 h-4 w-4 accent-pulse-500" />
							<label for="privacidad" class="text-sm text-graphite-600 dark:text-graphite-300">
								Acepto la <a href="/privacy" class="text-pulse-700 dark:text-pulse-400 hover:underline">política de privacidad</a> *
							</label>
						</div>

						<button type="submit" class="btn btn-primary w-full justify-center">
							Enviar mensaje
						</button>
					</form>
				</div>

				<div class="mt-4 p-4 border border-line dark:border-line-dark rounded-md">
					<p class="text-sm text-graphite-500 dark:text-graphite-400">
						Todos los campos marcados con * son obligatorios. Para consultas urgentes, escribe directamente al email académico.
					</p>
				</div>
			</div>
		</div>
	</div>
</Layout>

<div id="form-feedback" class="hidden mt-6 p-4 border border-signal-500 rounded-md text-center" role="alert">
	<p id="form-feedback-title" class="font-semibold text-signal-700 dark:text-signal-400 mb-1"></p>
	<p id="form-feedback-text" class="text-sm text-graphite-500 dark:text-graphite-400"></p>
</div>

<script is:inline src="/scripts/contacto.js"></script>
