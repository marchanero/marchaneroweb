---
import Layout from '../layouts/Layout.astro';
import RecentPublications from '../components/RecentPublications.astro';
import ScholarMetrics from '../components/ScholarMetrics.astro';
import SignalTrace from '../components/SignalTrace.astro';
import scholarData from '../data/scholar.json';
import home from '../../content/home.json';
import type { HomeData } from '../types/Content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import profileImage from '../assets/robert_ghibli.jpg';
import type { Publication } from '../types/Scholar';

const homeData = home as HomeData;

// Obtener las 3 publicaciones más recientes y convertir al formato esperado
const recentPublications = scholarData.publications.slice(0, 3).map(pub => ({
	title: pub.title,
	link: pub.link,
	citation_id: pub.citationId || '',
	authors: Array.isArray(pub.authors) ? pub.authors.join(', ') : pub.authors || '',
	publication: pub.publication || '',
	cited_by: {
		value: pub.citedBy || 0,
		link: pub.citedByLink || '',
		serpapi_link: '',
		cites_id: ''
	},
	year: (pub.year || 0).toString()
}));

// Contenido editable desde content/home.json y content/proyectos/ (CMS)
const researchLines: string[] = homeData.researchLines;

const featuredProjects = (await getCollection('proyectos'))
	.filter((p) => p.data.destacadoHome)
	.sort((a, b) => parseInt(b.data.fechaInicio) - parseInt(a.data.fechaInicio))
	.map((p, index) => ({
		tag: p.data.tag,
		status: p.data.estado,
		title: p.data.titulo,
		description: p.data.descripcion,
		period: `${p.data.fechaInicio} — ${p.data.fechaFin}`,
		budget: p.data.presupuesto,
		progress: p.data.progreso,
		href: '/proyectos',
		variant: (index % 2 === 0 ? 'ecg' : 'eda') as 'ecg' | 'eda',
	}));
---

<Layout title="Dr. Roberto Sánchez Reolid - Investigador en IA y Computación">
	<!-- Hero -->
	<section class="relative border-b border-line dark:border-line-dark overflow-hidden hero-wash">
		<div class="absolute inset-0 flex items-center opacity-[0.14] text-signal-500 dark:text-signal-400 pointer-events-none">
			<SignalTrace variant="ecg" width={1200} height={160} beats={6} strokeWidth={2.5} animate={false} class="w-full" />
		</div>

		<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20 flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
			<!-- Retrato -->
			<div class="lg:w-1/3">
				<div class="relative w-56 sm:w-72 mx-auto">
					<div class="relative border border-line dark:border-line-dark rounded-md overflow-hidden">
						<span class="spec-tick spec-tick-tl"></span>
						<span class="spec-tick spec-tick-br"></span>
						<Image
							src={profileImage}
							alt="Dr. Roberto Sánchez Reolid"
							class="w-full h-auto aspect-[4/5] object-cover object-top"
							widths={[400, 800]}
							sizes="(max-width: 768px) 100vw, 320px"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					<div class="mt-3 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wide text-graphite-500 dark:text-graphite-400">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full rounded-full bg-pulse-500 opacity-60 animate-ping"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-pulse-500"></span>
						</span>
						Disponible para colaboraciones
					</div>
				</div>
			</div>

			<!-- Contenido -->
			<div class="lg:w-2/3 text-center lg:text-left">
				<p class="eyebrow mb-3">Investigador · UCLM</p>
				<h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-graphite-900 dark:text-white leading-[1.02] mb-4">
					Roberto Sánchez <span class="text-pulse-600 dark:text-pulse-400">Reolid</span>
				</h1>
				<p class="text-lg text-graphite-600 dark:text-graphite-300 mb-2">Doctor en Informática</p>
				<p class="text-base sm:text-lg text-graphite-600 dark:text-graphite-300 max-w-2xl leading-relaxed mb-8 mx-auto lg:mx-0">
					Investigo <span class="font-medium text-pulse-600 dark:text-pulse-400">Inteligencia Artificial</span> y
					<span class="font-medium text-pulse-600 dark:text-pulse-400">procesamiento de señales fisiológicas</span>
					en la Universidad de Castilla-La Mancha.
				</p>

				<div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start mb-10">
					<a href="/publicaciones" class="btn btn-primary">Ver publicaciones →</a>
					<a href="/contacto" class="btn btn-outline">Contactar</a>
				</div>

				<div class="readout max-w-2xl mx-auto lg:mx-0">
					<div class="readout-cell">
						<div class="readout-value">{scholarData.metrics.totalCitations}</div>
						<div class="readout-label">Citas</div>
					</div>
					<div class="readout-cell">
						<div class="readout-value">{scholarData.metrics.hIndex}</div>
						<div class="readout-label">h-index</div>
					</div>
					<div class="readout-cell">
						<div class="readout-value">{scholarData.publications.length}</div>
						<div class="readout-label">Papers</div>
					</div>
					<div class="readout-cell">
						<div class="readout-value">{scholarData.metrics.i10Index}</div>
						<div class="readout-label">i10-index</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Mi investigación -->
	<section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b border-line dark:border-line-dark">
		<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-stretch">
			<div class="lg:col-span-2 reveal">
				<div class="spec-card h-full flex flex-col justify-between">
					<span class="spec-tick spec-tick-tl"></span>
					<span class="spec-tick spec-tick-br"></span>
					<div>
						<p class="eyebrow mb-2">Líneas de investigación</p>
						<h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-4">
							{homeData.introTitulo}
						</h2>
						<p class="text-graphite-600 dark:text-graphite-300 leading-relaxed mb-6">
							{homeData.introTexto}
						</p>
						<ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							{researchLines.map((line) => (
								<li class="flex items-center gap-2.5 px-4 py-3 border border-line dark:border-line-dark rounded-md text-sm text-graphite-700 dark:text-graphite-200">
									<span class="w-1.5 h-1.5 rounded-full bg-signal-500 shrink-0"></span>
									{line}
								</li>
							))}
						</ul>
					</div>
					<div class="flex flex-col sm:flex-row gap-3 mt-8">
						<a href="/sobre-mi" class="btn btn-primary btn-sm">Conocer más</a>
						<a href="/publicaciones" class="btn btn-outline btn-sm">Ver publicaciones</a>
					</div>
				</div>
			</div>

			<div class="lg:col-span-1 reveal">
				<ScholarMetrics compact={true} />
			</div>
		</div>
	</section>

	<!-- Publicaciones recientes -->
	<section class="py-14 sm:py-16 px-4 sm:px-6 lg:px-8 border-b border-line dark:border-line-dark">
		<div class="max-w-7xl mx-auto reveal">
			<RecentPublications
				publications={recentPublications}
				limit={3}
				showTitle={true}
				title="Publicaciones recientes"
			/>
		</div>
	</section>

	<!-- Investigaciones destacadas -->
	<section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8">
		<div class="max-w-7xl mx-auto">
			<div class="mb-10 text-center reveal">
				<p class="eyebrow mb-2">Proyectos</p>
				<h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white">
					Investigaciones destacadas
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
				{featuredProjects.map((project) => (
					<a href={project.href} class="spec-card block reveal">
						<span class="spec-tick spec-tick-tl"></span>
						<span class="spec-tick spec-tick-br"></span>

						<div class="h-20 -mx-6 -mt-6 mb-6 px-6 border-b border-line dark:border-line-dark flex items-center text-signal-500 dark:text-signal-400 overflow-hidden">
							<SignalTrace variant={project.variant} width={400} height={60} beats={4} class="w-full" />
						</div>

						<div class="flex items-center justify-between mb-3">
							<span class="eyebrow">{project.tag}</span>
							<span class="font-mono text-xs uppercase tracking-wide text-graphite-500 dark:text-graphite-400">
								{project.status}
							</span>
						</div>

						<h3 class="text-xl font-display font-bold text-graphite-900 dark:text-white mb-2">
							{project.title}
						</h3>
						<p class="text-graphite-600 dark:text-graphite-300 mb-5 leading-relaxed text-sm">
							{project.description}
						</p>

						<div class="flex items-center justify-between text-xs font-mono text-graphite-500 dark:text-graphite-400 mb-4">
							<span>{project.period}</span>
							<span>{project.budget}</span>
						</div>

						<div class="mb-1">
							<div class="flex items-center justify-between text-xs font-mono mb-1.5">
								<span class="text-graphite-500 dark:text-graphite-400">Progreso</span>
								<span class="text-pulse-600 dark:text-pulse-400">{project.progress}%</span>
							</div>
							<div class="signal-meter">
								{Array.from({ length: 10 }).map((_, i) => (
									<span class:list={['signal-meter-tick', i < project.progress / 10 && 'is-filled']}></span>
								))}
							</div>
						</div>
					</a>
				))}
			</div>

			<div class="text-center reveal">
				<a href="/proyectos" class="btn btn-outline">Ver todas las investigaciones →</a>
			</div>
		</div>
	</section>
</Layout>
