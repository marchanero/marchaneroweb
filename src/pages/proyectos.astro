---
import Layout from '../layouts/Layout.astro';
import SignalTrace from '../components/SignalTrace.astro';
import { getCollection } from 'astro:content';

// Datos de proyectos: editables en content/proyectos/ (manualmente o vía CMS /admin)
const proyectos = (await getCollection('proyectos')).map((p) => ({
	id: p.id,
	...p.data,
}));

const proyectosOrdenados = [...proyectos].sort((a, b) => {
	if (a.destacado !== b.destacado) return b.destacado ? 1 : -1;
	return parseInt(b.fechaInicio) - parseInt(a.fechaInicio);
});

const totalProyectos = proyectos.length;
const proyectosActivos = proyectos.filter(p => p.estado === 'En curso').length;
const proyectosFinalizados = proyectos.filter(p => p.estado === 'Finalizado').length;
const presupuestoTotal = proyectos.reduce((sum, p) => sum + parseInt(p.presupuesto.replace(/[€.\s]/g, '')), 0);

const trace = (i: number) => (i % 2 === 0 ? 'ecg' : 'eda') as 'ecg' | 'eda';
---

<Layout title="Proyectos de Investigación - Dr. Roberto Sánchez Reolid">
	<!-- Header -->
	<header class="relative border-b border-line dark:border-line-dark py-10 sm:py-16 hero-wash overflow-hidden">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<p class="eyebrow mb-3">Investigación aplicada</p>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-graphite-900 dark:text-white mb-4">
				Proyectos de investigación
			</h1>
			<p class="text-lg text-graphite-600 dark:text-graphite-300 max-w-2xl leading-relaxed mb-8">
				Tecnologías aplicadas a problemas reales en IA y sistemas distribuidos.
			</p>

			<div class="readout max-w-2xl">
				<div class="readout-cell">
					<div class="readout-value">{totalProyectos}</div>
					<div class="readout-label">Proyectos</div>
				</div>
				<div class="readout-cell">
					<div class="readout-value">{proyectosActivos}</div>
					<div class="readout-label">En curso</div>
				</div>
				<div class="readout-cell">
					<div class="readout-value">{proyectosFinalizados}</div>
					<div class="readout-label">Finalizados</div>
				</div>
				<div class="readout-cell">
					<div class="readout-value">{(presupuestoTotal / 1000).toFixed(0)}k€</div>
					<div class="readout-label">Financiación</div>
				</div>
			</div>
		</div>
	</header>

	<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
		<!-- Proyectos destacados -->
		<section class="mb-16 reveal">
			<p class="eyebrow mb-2">Destacados</p>
			<h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-2">
				Proyectos destacados
			</h2>
			<p class="text-graphite-500 dark:text-graphite-400 mb-8">Investigaciones principales con mayor impacto e innovación</p>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				{proyectosOrdenados.filter(p => p.destacado).map((proyecto, index) => (
					<article class="spec-card">
						<span class="spec-tick spec-tick-tl"></span>
						<span class="spec-tick spec-tick-br"></span>

						<div class="h-24 -mx-6 -mt-6 mb-6 px-6 border-b border-line dark:border-line-dark flex items-center justify-between text-signal-500 dark:text-signal-400 overflow-hidden">
							<SignalTrace variant={trace(index)} width={400} height={70} beats={4} class="w-full" />
							<span class="shrink-0 ml-4 font-mono text-xs uppercase tracking-wide px-2.5 py-1 border border-line dark:border-line-dark rounded-md text-graphite-600 dark:text-graphite-300">
								{proyecto.estado}
							</span>
						</div>

						<div class="flex flex-wrap gap-2 mb-4">
							{proyecto.etiquetas.map(etiqueta => (
								<span class="font-mono text-xs border border-line dark:border-line-dark text-graphite-600 dark:text-graphite-300 px-2.5 py-1 rounded-md">
									{etiqueta}
								</span>
							))}
						</div>

						<h3 class="text-xl font-display font-bold text-graphite-900 dark:text-white mb-3">
							{proyecto.titulo}
						</h3>
						<p class="text-graphite-600 dark:text-graphite-300 mb-5 leading-relaxed text-sm">
							{proyecto.descripcion}
						</p>

						<div class="mb-5">
							<div class="flex items-center justify-between text-xs font-mono mb-1.5">
								<span class="text-graphite-500 dark:text-graphite-400">Progreso</span>
								<span class="text-pulse-600 dark:text-pulse-400">{proyecto.progreso}%</span>
							</div>
							<div class="signal-meter">
								{Array.from({ length: 10 }).map((_, i) => (
									<span class:list={['signal-meter-tick', i < proyecto.progreso / 10 && 'is-filled']}></span>
								))}
							</div>
						</div>

						<div class="flex items-center justify-between text-xs font-mono text-graphite-500 dark:text-graphite-400 mb-6">
							<span>{proyecto.fechaInicio} — {proyecto.fechaFin}</span>
							<span>{proyecto.presupuesto}</span>
						</div>

						<div class="flex flex-wrap gap-2">
							<a href={proyecto.url} class="btn btn-primary btn-sm flex-1">Ver detalles completos</a>
							{proyecto.github && (
								<a href={proyecto.github} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">Código</a>
							)}
						</div>
					</article>
				))}
			</div>
		</section>

		<!-- Todos los proyectos -->
		<section class="reveal">
			<p class="eyebrow mb-2">Archivo</p>
			<h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">
				Portafolio completo
			</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{proyectosOrdenados.map((proyecto, index) => (
					<article class="spec-card">
						<span class="spec-tick spec-tick-tl"></span>
						<span class="spec-tick spec-tick-br"></span>

						<div class="flex items-center justify-between mb-4">
							<span class="font-mono text-xs uppercase tracking-wide px-2.5 py-1 border border-line dark:border-line-dark rounded-md text-graphite-600 dark:text-graphite-300">
								{proyecto.estado}
							</span>
							<span class="font-mono text-xs text-graphite-500 dark:text-graphite-400">{proyecto.fechaInicio}–{proyecto.fechaFin}</span>
						</div>

						<h3 class="text-lg font-display font-bold text-graphite-900 dark:text-white mb-3">
							{proyecto.titulo}
						</h3>

						<div class="flex flex-wrap gap-2 mb-4">
							{proyecto.etiquetas.map(etiqueta => (
								<span class="font-mono text-xs border border-line dark:border-line-dark text-graphite-600 dark:text-graphite-300 px-2.5 py-1 rounded-md">
									{etiqueta}
								</span>
							))}
						</div>

						<p class="text-graphite-600 dark:text-graphite-300 text-sm mb-4 leading-relaxed">
							{proyecto.descripcion}
						</p>

						<div class="flex items-center justify-between text-sm mb-4">
							<span class="text-graphite-500 dark:text-graphite-400">Financiación</span>
							<span class="font-mono text-graphite-800 dark:text-graphite-100">{proyecto.presupuesto}</span>
						</div>

						<div class="mb-5">
							<div class="signal-meter">
								{Array.from({ length: 10 }).map((_, i) => (
									<span class:list={['signal-meter-tick', i < proyecto.progreso / 10 && 'is-filled']}></span>
								))}
							</div>
						</div>

						{proyecto.resultados && proyecto.resultados.length > 0 && (
							<ul class="space-y-1.5 mb-5">
								{proyecto.resultados.slice(0, 2).map(resultado => (
									<li class="text-sm text-graphite-500 dark:text-graphite-400 flex items-start gap-2">
										<span class="w-1 h-1 rounded-full bg-signal-500 mt-2 shrink-0"></span>
										<span>{resultado}</span>
									</li>
								))}
							</ul>
						)}

						<div class="flex gap-2">
							<a href={proyecto.url} class="btn btn-primary btn-sm flex-1">Ver detalles completos</a>
							{proyecto.github && (
								<a href={proyecto.github} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" title="Ver código en GitHub" aria-label="Ver código en GitHub">
									<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
										<path d="M12 0C5.374 0 0 5.373 0 12 0 17.302 3.438 21.8 8.207 23.387c.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
									</svg>
								</a>
							)}
						</div>
					</article>
				))}
			</div>
		</section>

		<!-- Call to action -->
		<section class="mt-16 text-center reveal">
			<div class="spec-card p-8">
				<span class="spec-tick spec-tick-tl"></span>
				<span class="spec-tick spec-tick-br"></span>
				<h3 class="text-xl sm:text-2xl font-display font-bold text-graphite-900 dark:text-white mb-3">
					¿Interesado en colaborar?
				</h3>
				<p class="text-graphite-600 dark:text-graphite-300 mb-6 max-w-2xl mx-auto">
					Si tienes ideas para proyectos innovadores o quieres formar parte de nuestro equipo de investigación,
					no dudes en ponerte en contacto conmigo.
				</p>
				<div class="flex flex-wrap justify-center gap-3">
					<a href="/contacto" class="btn btn-primary">Contactar</a>
					<a href="/publicaciones" class="btn btn-outline">Ver publicaciones</a>
				</div>
			</div>
		</section>
	</div>
</Layout>
