---
import Layout from '../layouts/Layout.astro';
import SignalTrace from '../components/SignalTrace.astro';
import { getCollection } from 'astro:content';

// Datos de asignaturas: editables en content/asignaturas/ (manualmente o vía CMS /admin)
const asignaturas = (await getCollection('asignaturas'))
	.map((a) => ({
		id: a.id,
		...a.data,
	}))
	.sort((a, b) => parseInt(a.curso) - parseInt(b.curso) || a.codigo.localeCompare(b.codigo));

const aniosAcademicos = [...new Set(asignaturas.map(a => a.academicYear))];
const totalCreditos = asignaturas.reduce((sum, a) => sum + a.creditos, 0);

const recursos = [
	{
		titulo: 'Guías de estudio',
		desc: 'Material complementario para preparar exámenes',
		icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
	},
	{
		titulo: 'Proyectos de ejemplo',
		desc: 'Ejemplos prácticos para inspirar tus propios proyectos',
		icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
	},
	{
		titulo: 'Videotutoriales',
		desc: 'Explicaciones paso a paso en formato vídeo',
		icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
	},
	{
		titulo: 'Notebooks y ejercicios',
		desc: 'Cuadernos interactivos y ejercicios prácticos',
		icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
	},
];
---

<Layout title="Docencia | Roberto Sánchez Reolid">
	<!-- Header -->
	<header class="relative border-b border-line dark:border-line-dark py-10 sm:py-16 px-4 sm:px-6 lg:px-8 hero-wash overflow-hidden">
		<div class="max-w-5xl mx-auto text-center">
			<p class="eyebrow mb-3">Universidad de Castilla-La Mancha</p>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-graphite-900 dark:text-white mb-4">
				Docencia
			</h1>
			<p class="text-lg text-graphite-600 dark:text-graphite-300 max-w-2xl mx-auto mb-2">
				Asignaturas impartidas en el Grado en Ingeniería Informática, campus de Talavera
			</p>
			<p class="text-graphite-500 dark:text-graphite-400 max-w-2xl mx-auto">
				Programación, inteligencia artificial y análisis de datos.
			</p>

			<div class="readout max-w-2xl mx-auto mt-10">
				<div class="readout-cell">
					<div class="readout-value">{asignaturas.length}</div>
					<div class="readout-label">Asignaturas</div>
				</div>
				<div class="readout-cell">
					<div class="readout-value">{totalCreditos}</div>
					<div class="readout-label">Créditos ECTS</div>
				</div>
				<div class="readout-cell">
					<div class="readout-value">4º</div>
					<div class="readout-label">Curso más alto</div>
				</div>
				<div class="readout-cell">
					<div class="readout-value">1º</div>
					<div class="readout-label">Curso más bajo</div>
				</div>
			</div>
		</div>
	</header>

	<main class="py-10 sm:py-16 px-4 sm:px-6 lg:px-8">
		<div class="max-w-6xl mx-auto">
			<!-- Filtros -->
			<section class="mb-12 reveal">
				<div class="spec-card p-6 sm:p-8">
					<span class="spec-tick spec-tick-tl"></span>
					<span class="spec-tick spec-tick-br"></span>
					<p class="eyebrow mb-6">Filtrar</p>

					<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
						<div>
							<label for="nivel" class="block text-xs font-mono uppercase tracking-wide text-graphite-500 dark:text-graphite-400 mb-2">Nivel académico</label>
							<select id="nivel" class="w-full px-3 py-2 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-700 dark:text-graphite-200 text-sm focus:outline-none focus:border-pulse-500">
								<option value="todos">Todos los niveles</option>
								<option value="grado">Grado</option>
								<option value="master">Máster</option>
								<option value="doctorado">Doctorado</option>
							</select>
						</div>

						<div>
							<label for="anioAcademico" class="block text-xs font-mono uppercase tracking-wide text-graphite-500 dark:text-graphite-400 mb-2">Año académico</label>
							<select id="anioAcademico" class="w-full px-3 py-2 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-700 dark:text-graphite-200 text-sm focus:outline-none focus:border-pulse-500">
								<option value="todos">Todos los años</option>
								{aniosAcademicos.map(anio => (
									<option value={anio}>{anio}</option>
								))}
							</select>
						</div>

						<div>
							<label for="busqueda" class="block text-xs font-mono uppercase tracking-wide text-graphite-500 dark:text-graphite-400 mb-2">Búsqueda</label>
							<input type="text" id="busqueda" placeholder="Nombre o código..." class="w-full px-3 py-2 border border-line dark:border-line-dark rounded-md bg-transparent text-graphite-700 dark:text-graphite-200 text-sm placeholder:text-graphite-400 focus:outline-none focus:border-pulse-500" />
						</div>
					</div>
				</div>
			</section>

			<!-- Lista de asignaturas -->
			<section class="mb-16 reveal">
				<h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">
					Asignaturas <span id="resultCount" class="font-mono text-graphite-400 dark:text-graphite-500 text-xl">({asignaturas.length})</span>
				</h2>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="subjectGrid">
					{asignaturas.map((asignatura) => (
						<article
							class="subject-card spec-card"
							data-nivel={asignatura.nivel}
							data-anio={asignatura.academicYear}
							data-search={`${asignatura.titulo} ${asignatura.codigo}`.toLowerCase()}
						>
							<span class="spec-tick spec-tick-tl"></span>
							<span class="spec-tick spec-tick-br"></span>

							<div class="h-16 -mx-6 -mt-6 mb-6 px-6 border-b border-line dark:border-line-dark flex items-center justify-between text-signal-500 dark:text-signal-400 overflow-hidden">
								<SignalTrace variant="eda" width={300} height={40} beats={3} class="w-2/3" />
								<span class="shrink-0 font-mono text-xs text-graphite-500 dark:text-graphite-400">{asignatura.creditos} ECTS</span>
							</div>

							<div class="flex items-center gap-2 mb-3">
								<span class="font-mono text-xs text-graphite-500 dark:text-graphite-400">{asignatura.codigo}</span>
								{asignatura.destacada && (
									<span class="eyebrow">Destacada</span>
								)}
							</div>

							<h3 class="text-lg font-semibold text-graphite-900 dark:text-white mb-2">
								{asignatura.titulo}
							</h3>

							<p class="text-graphite-500 dark:text-graphite-400 text-xs font-mono mb-4">
								{asignatura.curso} curso · {asignatura.cuatrimestre} cuatrimestre
							</p>

							<p class="text-graphite-600 dark:text-graphite-300 text-sm mb-6 line-clamp-3">
								{asignatura.descripcion}
							</p>

							<div class="flex items-center justify-between pt-4 border-t border-line dark:border-line-dark">
								<span class="text-xs text-graphite-500 dark:text-graphite-400">{asignatura.horario}</span>
								<a href={asignatura.enlaceMateriales} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium text-pulse-600 dark:text-pulse-400 hover:text-pulse-700 dark:hover:text-pulse-300">
									Materiales
									<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
									</svg>
								</a>
							</div>
						</article>
					))}
				</div>

				<p id="noResults" class="hidden text-center py-16 text-graphite-500 dark:text-graphite-400">
					No hay asignaturas que coincidan con los filtros.
				</p>
			</section>

			<!-- Materiales complementarios -->
			<section class="mb-16 reveal">
				<div class="spec-card p-6 sm:p-8">
					<span class="spec-tick spec-tick-tl"></span>
					<span class="spec-tick spec-tick-br"></span>
					<div class="text-center mb-10">
						<p class="eyebrow mb-2">Recursos</p>
						<h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-3">
							Materiales complementarios
						</h2>
						<p class="text-graphite-600 dark:text-graphite-300 max-w-2xl mx-auto">
							Además de las asignaturas oficiales, pongo a disposición de los estudiantes materiales
							complementarios y recursos adicionales para profundizar en los temas tratados en clase.
						</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						{recursos.map((recurso) => (
							<div class="flex items-start gap-4 p-4 border border-line dark:border-line-dark rounded-md">
								<div class="w-10 h-10 shrink-0 border border-line dark:border-line-dark rounded-md flex items-center justify-center text-signal-500 dark:text-signal-400">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={recurso.icon}></path>
									</svg>
								</div>
								<div>
									<h3 class="text-base font-semibold text-graphite-900 dark:text-white mb-1">{recurso.titulo}</h3>
									<p class="text-sm text-graphite-500 dark:text-graphite-400">{recurso.desc}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Tutoría -->
			<section class="mb-16 reveal">
				<div class="spec-card p-6 sm:p-8">
					<span class="spec-tick spec-tick-tl"></span>
					<span class="spec-tick spec-tick-br"></span>
					<p class="eyebrow mb-2 text-center">Atención al estudiante</p>
					<h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-10 text-center">
						Tutoría
					</h2>

					<div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
						<div class="space-y-5">
							<div class="flex items-start gap-4">
								<div class="w-10 h-10 shrink-0 border border-line dark:border-line-dark rounded-md flex items-center justify-center text-signal-500 dark:text-signal-400">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
								</div>
								<div>
									<h4 class="font-semibold text-graphite-900 dark:text-white mb-1">Primer cuatrimestre</h4>
									<p class="text-sm text-graphite-500 dark:text-graphite-400">Lunes y miércoles de 12:00 a 14:00</p>
								</div>
							</div>
							<div class="flex items-start gap-4">
								<div class="w-10 h-10 shrink-0 border border-line dark:border-line-dark rounded-md flex items-center justify-center text-signal-500 dark:text-signal-400">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
								</div>
								<div>
									<h4 class="font-semibold text-graphite-900 dark:text-white mb-1">Segundo cuatrimestre</h4>
									<p class="text-sm text-graphite-500 dark:text-graphite-400">Martes y jueves de 10:00 a 12:00</p>
								</div>
							</div>
							<div class="flex items-start gap-4">
								<div class="w-10 h-10 shrink-0 border border-line dark:border-line-dark rounded-md flex items-center justify-center text-signal-500 dark:text-signal-400">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
									</svg>
								</div>
								<div>
									<h4 class="font-semibold text-graphite-900 dark:text-white mb-1">Ubicación</h4>
									<p class="text-sm text-graphite-500 dark:text-graphite-400">Despacho 2.13, Edificio Politécnico</p>
								</div>
							</div>
						</div>

						<div class="flex flex-col justify-center">
							<h3 class="text-lg font-semibold text-graphite-900 dark:text-white mb-3">Solicitar tutoría</h3>
							<p class="text-graphite-600 dark:text-graphite-300 mb-6">
								Puedes concertar una tutoría personalizada mediante el siguiente formulario.
								Indícame el motivo de la consulta y tu disponibilidad horaria.
							</p>
							<a href="/contacto?asunto=tutoria" class="btn btn-primary self-start">Solicitar tutoría →</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Call to action -->
			<section class="text-center reveal">
				<div class="spec-card p-8 sm:p-12">
					<span class="spec-tick spec-tick-tl"></span>
					<span class="spec-tick spec-tick-br"></span>
					<h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-4">
						¿Quieres saber más sobre mis asignaturas?
					</h2>
					<p class="text-graphite-600 dark:text-graphite-300 mb-8 max-w-2xl mx-auto">
						Si tienes alguna pregunta sobre el contenido de las asignaturas, metodología de enseñanza
						o cualquier aspecto relacionado con mi labor docente, no dudes en contactarme.
					</p>
					<div class="flex flex-col sm:flex-row gap-3 justify-center">
						<a href="/contacto" class="btn btn-primary">Contactar</a>
						<a href="/sobre-mi" class="btn btn-outline">Conoce más sobre mí</a>
					</div>
				</div>
			</section>
		</div>
	</main>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const selectNivel = document.getElementById('nivel') as HTMLSelectElement;
			const selectAnio = document.getElementById('anioAcademico') as HTMLSelectElement;
			const inputBusqueda = document.getElementById('busqueda') as HTMLInputElement;
			const cards = document.querySelectorAll<HTMLElement>('.subject-card');
			const noResults = document.getElementById('noResults');
			const resultCount = document.getElementById('resultCount');

			function applyFilters() {
				const nivel = selectNivel?.value || 'todos';
				const anio = selectAnio?.value || 'todos';
				const busqueda = (inputBusqueda?.value || '').toLowerCase().trim();

				let visible = 0;
				cards.forEach((card) => {
					const matchNivel = nivel === 'todos' || card.dataset.nivel === nivel;
					const matchAnio = anio === 'todos' || card.dataset.anio === anio;
					const matchBusqueda = !busqueda || (card.dataset.search || '').includes(busqueda);
					const show = matchNivel && matchAnio && matchBusqueda;
					card.classList.toggle('hidden', !show);
					if (show) visible++;
				});

				if (resultCount) resultCount.textContent = `(${visible})`;
				noResults?.classList.toggle('hidden', visible !== 0);
			}

			selectNivel?.addEventListener('change', applyFilters);
			selectAnio?.addEventListener('change', applyFilters);
			inputBusqueda?.addEventListener('input', applyFilters);
		});
	</script>
</Layout>
