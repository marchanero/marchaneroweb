---
import Layout from '../layouts/Layout.astro';

const title = "Currículum - Dr. Roberto Sánchez Reolid";
const description = "Currículum vitae académico y profesional del Dr. Roberto Sánchez Reolid, con formación, experiencia docente e investigadora";

// Datos del CV (en producción podrían venir de un CMS o archivo JSON)
const educacion = [
  {
    titulo: "Doctorado en Informática",
    institucion: "Universidad de Castilla-La Mancha",
    periodo: "2015 - 2019",
    descripcion: "Tesis: 'Modelos de aprendizaje automático para la detección de emociones mediante señales fisiológicas'."
  },
  {
    titulo: "Máster en Tecnologías de la Información",
    institucion: "Universidad de Castilla-La Mancha",
    periodo: "2013 - 2015",
    descripcion: "Especialización en Inteligencia Artificial y Computación Avanzada."
  },
  {
    titulo: "Ingeniería Informática",
    institucion: "Universidad de Castilla-La Mancha",
    periodo: "2008 - 2013",
    descripcion: "Premio Extraordinario Fin de Carrera."
  }
];

const experienciaDocente = [
  {
    puesto: "Profesor Ayudante Doctor",
    departamento: "Departamento de Sistemas Informáticos",
    universidad: "Universidad de Castilla-La Mancha",
    periodo: "2021 - Actualidad",
    asignaturas: [
      "Inteligencia Artificial",
      "Aprendizaje Automático",
      "Sistemas Inteligentes"
    ]
  },
  {
    puesto: "Profesor Asociado",
    departamento: "Departamento de Sistemas Informáticos",
    universidad: "Universidad de Castilla-La Mancha",
    periodo: "2019 - 2021",
    asignaturas: [
      "Fundamentos de Programación",
      "Inteligencia Artificial"
    ]
  }
];

const experienciaInvestigadora = [
  {
    puesto: "Investigador Principal",
    proyecto: "Sistemas de reconocimiento emocional para entornos educativos",
    entidad: "Ministerio de Ciencia e Innovación",
    periodo: "2022 - Actualidad",
    codigo: "TIN2022-12345",
    descripcion: "Desarrollo de sistemas basados en IA para la detección de estados emocionales en el aula."
  },
  {
    puesto: "Investigador",
    proyecto: "Computación afectiva para mejora de interfaces hombre-máquina",
    entidad: "Proyecto Europeo H2020",
    periodo: "2020 - 2022",
    codigo: "H2020-ICT-2020-1",
    descripcion: "Diseño de interfaces adaptativas basadas en el estado emocional del usuario."
  }
];

const estancias = [
  {
    centro: "Massachusetts Institute of Technology (MIT)",
    departamento: "Computer Science and Artificial Intelligence Laboratory",
    pais: "Estados Unidos",
    periodo: "2018",
    duracion: "6 meses",
    descripcion: "Investigación en algoritmos de aprendizaje por refuerzo para interfaces adaptativas."
  },
  {
    centro: "Universidad de Cambridge",
    departamento: "Department of Computer Science and Technology",
    pais: "Reino Unido",
    periodo: "2017",
    duracion: "3 meses",
    descripcion: "Análisis de señales fisiológicas para reconocimiento emocional."
  }
];

const reconocimientos = [
  {
    titulo: "Premio de Investigación en IA",
    entidad: "Fundación Española para la Ciencia y la Tecnología",
    anio: 2021
  },
  {
    titulo: "Mejor Tesis Doctoral en Informática",
    entidad: "Asociación de Ingeniería Informática",
    anio: 2020
  },
  {
    titulo: "Mejor Artículo",
    entidad: "International Conference on Affective Computing",
    anio: 2020
  }
];
---

<Layout title={title} description={description}>
  <!-- Header -->
  <header class="relative border-b border-line dark:border-line-dark py-14 sm:py-20 px-4 hero-wash overflow-hidden">
    <div class="max-w-4xl mx-auto text-center reveal">
      <p class="eyebrow mb-3">Trayectoria</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-graphite-900 dark:text-white mb-4">
        Currículum vitae
      </h1>
      <p class="text-lg text-graphite-600 dark:text-graphite-300 max-w-2xl mx-auto">
        Profesor e investigador en Inteligencia Artificial, computación afectiva y aprendizaje automático
      </p>

      <div class="mt-10 flex flex-col sm:flex-row justify-center gap-3">
        <a href="/files/CV_RobertoSanchezReolid.pdf" class="btn btn-primary">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          Descargar CV completo
        </a>
        <a href="/contacto" class="btn btn-outline">Contacto</a>
      </div>
    </div>
  </header>

  <main class="py-14 sm:py-20">
    <!-- Educación -->
    <section class="max-w-4xl mx-auto px-4 mb-16 reveal">
      <p class="eyebrow mb-2">2008 — 2019</p>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Formación académica</h2>

      <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
        {educacion.map((item) => (
          <div class="relative">
            <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
            <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo}</p>
            <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.titulo}</h3>
            <p class="text-signal-600 dark:text-signal-400 text-sm mb-2">{item.institucion}</p>
            <p class="text-graphite-600 dark:text-graphite-300 text-sm leading-relaxed">{item.descripcion}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Experiencia Docente -->
    <section class="max-w-4xl mx-auto px-4 mb-16 reveal">
      <p class="eyebrow mb-2">2019 — Actualidad</p>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Experiencia docente</h2>

      <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
        {experienciaDocente.map((item) => (
          <div class="relative">
            <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
            <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo}</p>
            <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.puesto}</h3>
            <p class="text-signal-600 dark:text-signal-400 text-sm mb-3">{item.departamento}, {item.universidad}</p>
            <p class="text-sm font-medium text-graphite-700 dark:text-graphite-200 mb-2">Asignaturas impartidas</p>
            <div class="flex flex-wrap gap-2">
              {item.asignaturas.map(asignatura => (
                <span class="border border-line dark:border-line-dark text-graphite-600 dark:text-graphite-300 px-3 py-1 rounded-md text-xs font-mono">{asignatura}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experiencia Investigadora -->
    <section class="max-w-4xl mx-auto px-4 mb-16 reveal">
      <p class="eyebrow mb-2">2020 — Actualidad</p>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Experiencia investigadora</h2>

      <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
        {experienciaInvestigadora.map((item) => (
          <div class="relative">
            <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
            <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo} · {item.codigo}</p>
            <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.proyecto}</h3>
            <p class="text-sm mb-2">
              <span class="text-signal-600 dark:text-signal-400">{item.puesto}</span>
              <span class="text-graphite-400 mx-2">·</span>
              <span class="text-graphite-500 dark:text-graphite-400">{item.entidad}</span>
            </p>
            <p class="text-graphite-600 dark:text-graphite-300 text-sm leading-relaxed">{item.descripcion}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Estancias de Investigación -->
    <section class="max-w-4xl mx-auto px-4 mb-16 reveal">
      <p class="eyebrow mb-2">2017 — 2018</p>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Estancias de investigación</h2>

      <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
        {estancias.map((item) => (
          <div class="relative">
            <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
            <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo} · {item.duracion}</p>
            <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.centro}</h3>
            <p class="text-signal-600 dark:text-signal-400 text-sm mb-2">{item.departamento} · {item.pais}</p>
            <p class="text-graphite-600 dark:text-graphite-300 text-sm leading-relaxed">{item.descripcion}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Reconocimientos -->
    <section class="max-w-4xl mx-auto px-4 mb-16 reveal">
      <p class="eyebrow mb-2">Distinciones</p>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Reconocimientos</h2>

      <div class="grid sm:grid-cols-3 gap-4">
        {reconocimientos.map((item) => (
          <div class="spec-card">
            <span class="spec-tick spec-tick-tl"></span>
            <span class="spec-tick spec-tick-br"></span>
            <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-2">{item.anio}</p>
            <h3 class="text-base font-semibold text-graphite-900 dark:text-white mb-1">{item.titulo}</h3>
            <p class="text-sm text-graphite-500 dark:text-graphite-400">{item.entidad}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Llamada a la acción -->
    <div class="max-w-4xl mx-auto px-4 text-center reveal">
      <div class="spec-card p-8 sm:p-12">
        <span class="spec-tick spec-tick-tl"></span>
        <span class="spec-tick spec-tick-br"></span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-4">¿Interesado en colaborar?</h2>
        <p class="text-graphite-600 dark:text-graphite-300 mb-8">Estoy disponible para proyectos de investigación, consultoría o charlas</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href="/files/CV_RobertoSanchezReolid.pdf" class="btn btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            Descargar CV completo
          </a>
          <a href="/contacto" class="btn btn-outline">Contactar</a>
        </div>
      </div>
    </div>
  </main>
</Layout>
