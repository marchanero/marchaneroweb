---
import Layout from '../layouts/Layout.astro';
import cv from '../../content/cv.json';
import type { CvData, CuartilesData, CuartilItem } from '../types/Content';
import scholarData from '../data/scholar.json';
import cuartilesData from '../../content/publicaciones-cuartiles.json';

const cvData = cv as CvData;
const cuartilesRaw = cuartilesData as CuartilesData;

const title = "Currículum - Dr. Roberto Sánchez Reolid";
const description = "Currículum vitae académico y profesional del Dr. Roberto Sánchez Reolid, con formación, experiencia docente e investigadora";

// Contenido editable desde content/cv.json (CMS)
const educacion = cvData.educacion ?? [];
const experienciaProfesional = cvData.experienciaProfesional ?? [];
const experienciaDocente = cvData.experienciaDocente ?? [];
const experienciaInvestigadora = cvData.experienciaInvestigadora ?? [];
const estancias = cvData.estancias ?? [];
const gestionAcademica = cvData.gestionAcademica ?? [];
const reconocimientos = cvData.reconocimientos ?? [];

// Cuartiles JCR/SJR (content/publicaciones-cuartiles.json, mantenido a mano — sin API pública
// de Clarivate/FECYT) emparejados por título con las publicaciones sincronizadas de Scholar.
// Google Scholar trunca los títulos largos con "…", de ahí la comparación por prefijo.
function normalizarTitulo(str: string) {
  return str
    .toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/…$/, '')
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

// Compara dos títulos normalizados: iguales, uno prefijo del otro (truncamiento de Scholar),
// o con un prefijo común muy largo (variantes con alguna palabra distinta, p. ej. "pilot study
// protocol" vs. "study protocol" del mismo artículo).
function tituloSimilar(a: string, b: string) {
  if (a === b || a.startsWith(b) || b.startsWith(a)) return true;
  const minLen = Math.min(a.length, b.length);
  let comun = 0;
  while (comun < minLen && a[comun] === b[comun]) comun++;
  return comun / minLen >= 0.75;
}

const cuartilesPorTitulo = (cuartilesRaw.cuartiles ?? []).map((c) => ({
  ...c,
  _norm: normalizarTitulo(c.titulo),
}));

function buscarCuartil(tituloPublicacion: string) {
  const norm = normalizarTitulo(tituloPublicacion);
  return cuartilesPorTitulo.find((c) => tituloSimilar(c._norm, norm));
}

// Google Scholar indexa algunos artículos por duplicado (título truncado distinto,
// preprint vs. versión final...). Se deduplican quedándose con la entrada de más citas.
function deduplicarPorTitulo(pubs: any[]) {
  const grupos: { norm: string; pub: any }[] = [];
  for (const pub of pubs) {
    const norm = normalizarTitulo(pub.title);
    const grupo = grupos.find((g) => tituloSimilar(g.norm, norm));
    if (!grupo) {
      grupos.push({ norm, pub });
    } else if ((pub.citedBy ?? 0) > (grupo.pub.citedBy ?? 0)) {
      grupo.pub = pub;
    }
  }
  return grupos.map((g) => g.pub);
}

// Publicaciones (artículos y revistas, sin ponencias) para la versión imprimible, ordenadas por citas
const publicacionesImpresion = deduplicarPorTitulo(
  (scholarData.publications ?? []).filter((pub) => pub.type !== 'conference')
)
  .sort((a, b) => (b.citedBy ?? 0) - (a.citedBy ?? 0))
  .map((pub) => ({ ...pub, cuartil: buscarCuartil(pub.title) }));
---

<Layout title={title} description={description}>
  <!-- Header -->
  <header class="relative border-b border-line dark:border-line-dark py-10 sm:py-16 px-4 sm:px-6 lg:px-8 hero-wash overflow-hidden">
    <div class="max-w-4xl mx-auto text-center">
      <p class="eyebrow mb-3">Trayectoria</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold text-graphite-900 dark:text-white mb-2">
        Currículum vitae
      </h1>
      <p class="text-xl sm:text-2xl font-display font-semibold text-pulse-600 dark:text-pulse-400 mb-4">
        Dr. Roberto Sánchez Reolid
      </p>
      <p class="text-lg text-graphite-600 dark:text-graphite-300 max-w-2xl mx-auto">
        Profesor e investigador en Inteligencia Artificial, computación afectiva y aprendizaje automático
      </p>
      <p class="hidden print:block mt-3 font-mono text-xs text-graphite-500">
        Universidad de Castilla-La Mancha · roberto.sanchez@uclm.es · scholar.google.com/citations?user=PCALePwAAAAJ
      </p>

      <div class="mt-10 flex flex-col sm:flex-row justify-center gap-3 print:hidden">
        <a href="/files/CV_RobertoSanchezReolid.pdf" download class="btn btn-primary">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          Descargar CV en PDF
        </a>
        <a href="/contacto" class="btn btn-outline">Contacto</a>
      </div>
    </div>
  </header>

  <main class="py-10 sm:py-16">
    <!-- Educación -->
    {educacion.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 reveal">
        <p class="eyebrow mb-2">Trayectoria</p>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Formación académica</h2>

        <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
          {educacion.map((item) => (
            <div class="relative">
              <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
              {item.periodo && <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo}</p>}
              <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.titulo}</h3>
              <p class="text-pulse-600 dark:text-pulse-400 text-sm mb-2">{item.institucion}</p>
              {item.descripcion && <p class="text-graphite-600 dark:text-graphite-300 text-sm leading-relaxed">{item.descripcion}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Experiencia Profesional -->
    {experienciaProfesional.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 reveal">
        <p class="eyebrow mb-2">Trayectoria</p>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Experiencia profesional</h2>

        <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
          {experienciaProfesional.map((item) => (
            <div class="relative">
              <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
              <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo}</p>
              <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.puesto}</h3>
              <p class="text-pulse-600 dark:text-pulse-400 text-sm mb-2">{item.entidad}</p>
              {item.descripcion && <p class="text-graphite-600 dark:text-graphite-300 text-sm leading-relaxed">{item.descripcion}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Experiencia Docente -->
    {experienciaDocente.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 reveal">
        <p class="eyebrow mb-2">Docencia</p>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Experiencia docente</h2>

        <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
          {experienciaDocente.map((item) => (
            <div class="relative">
              <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
              <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo}</p>
              <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.puesto}</h3>
              <p class="text-pulse-600 dark:text-pulse-400 text-sm mb-3">{item.departamento}, {item.universidad}</p>
              <p class="text-sm font-medium text-graphite-700 dark:text-graphite-200 mb-2">Asignaturas impartidas</p>
              <div class="flex flex-wrap gap-2">
                {item.asignaturas.map(asignatura => (
                  <span class="border border-line dark:border-line-dark text-graphite-600 dark:text-graphite-300 px-3 py-1 rounded-md text-xs font-mono">{asignatura}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Experiencia Investigadora -->
    {experienciaInvestigadora.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 reveal">
        <p class="eyebrow mb-2">Investigación</p>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Experiencia investigadora</h2>

        <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
          {experienciaInvestigadora.map((item) => (
            <div class="relative">
              <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
              <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo}{item.codigo && ` · ${item.codigo}`}</p>
              <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.proyecto}</h3>
              <p class="text-sm mb-2">
                <span class="text-pulse-600 dark:text-pulse-400">{item.puesto}</span>
                <span class="text-graphite-400 mx-2">·</span>
                <span class="text-graphite-500 dark:text-graphite-400">{item.entidad}</span>
              </p>
              {item.descripcion && <p class="text-graphite-600 dark:text-graphite-300 text-sm leading-relaxed">{item.descripcion}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Estancias de Investigación -->
    {estancias.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 reveal">
        <p class="eyebrow mb-2">Movilidad</p>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Estancias de investigación</h2>

        <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
          {estancias.map((item) => (
            <div class="relative">
              <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
              <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo}{item.duracion && ` · ${item.duracion}`}</p>
              <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.centro}</h3>
              <p class="text-pulse-600 dark:text-pulse-400 text-sm mb-2">{item.departamento}{item.departamento && item.pais && ' · '}{item.pais}</p>
              {item.descripcion && <p class="text-graphite-600 dark:text-graphite-300 text-sm leading-relaxed">{item.descripcion}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Gestión Académica -->
    {gestionAcademica.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 reveal">
        <p class="eyebrow mb-2">Servicio</p>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Gestión académica</h2>

        <div class="relative border-l border-line dark:border-line-dark pl-6 space-y-8">
          {gestionAcademica.map((item) => (
            <div class="relative">
              <span class="absolute -left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-signal-500"></span>
              <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-1">{item.periodo}</p>
              <h3 class="text-lg font-semibold text-graphite-900 dark:text-white">{item.cargo}</h3>
              <p class="text-pulse-600 dark:text-pulse-400 text-sm mb-2">{item.institucion}</p>
              {item.descripcion && <p class="text-graphite-600 dark:text-graphite-300 text-sm leading-relaxed">{item.descripcion}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Publicaciones: solo en la versión imprimible/PDF; en pantalla ya están en /publicaciones -->
    {publicacionesImpresion.length > 0 && (
      <section class="hidden print:block max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
        <p class="eyebrow mb-1">Producción científica</p>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 mb-1">Publicaciones</h2>
        <p class="font-mono text-xs text-graphite-500 mb-6">{publicacionesImpresion.length} artículos y revistas · ordenados por número de citas</p>

        <ol class="divide-y divide-line">
          {publicacionesImpresion.map((pub, i) => (
            <li class="flex items-start gap-3 py-3 [break-inside:avoid]">
              <span class="shrink-0 w-6 text-right font-mono text-xs text-graphite-400 pt-0.5">{i + 1}</span>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-graphite-900 leading-snug">{pub.title}.</p>
                <p class="text-graphite-500 text-xs mt-0.5">{pub.authors?.join(', ')} — {pub.publication}.</p>
                {pub.cuartil && (
                  <p class="mt-1 flex flex-wrap items-center gap-x-1.5 font-mono text-[0.65rem]">
                    <span class="border border-signal-500 text-signal-700 rounded px-1.5 py-0.5 font-semibold">{pub.cuartil.cuartil}</span>
                    {pub.cuartil.categoria && (
                      <span class="text-graphite-400">{pub.cuartil.categoria}{pub.cuartil.posicion ? ` (${pub.cuartil.posicion})` : ''}</span>
                    )}
                    {pub.cuartil.impactFactor && <span class="text-graphite-400">· IF {pub.cuartil.impactFactor}</span>}
                  </p>
                )}
              </div>
              <span class="shrink-0 font-mono text-xs font-semibold text-pulse-600 pt-0.5 tabular-nums" title="Citas">{pub.citedBy ?? 0}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Reconocimientos -->
    {reconocimientos.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 reveal">
        <p class="eyebrow mb-2">Distinciones</p>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-8">Reconocimientos</h2>

        <div class="grid sm:grid-cols-3 gap-4">
          {reconocimientos.map((item) => (
            <div class="spec-card">
              <span class="spec-tick spec-tick-tl"></span>
              <span class="spec-tick spec-tick-br"></span>
              <p class="font-mono text-xs text-graphite-500 dark:text-graphite-400 mb-2">{item.anio}</p>
              <h3 class="text-base font-semibold text-graphite-900 dark:text-white mb-1">{item.titulo}</h3>
              <p class="text-sm text-graphite-500 dark:text-graphite-400">{item.entidad}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Llamada a la acción -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal print:hidden">
      <div class="spec-card p-8 sm:p-12">
        <span class="spec-tick spec-tick-tl"></span>
        <span class="spec-tick spec-tick-br"></span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white mb-4">¿Interesado en colaborar?</h2>
        <p class="text-graphite-600 dark:text-graphite-300 mb-8">Estoy disponible para proyectos de investigación, consultoría o charlas</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href="/files/CV_RobertoSanchezReolid.pdf" download class="btn btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            Descargar CV en PDF
          </a>
          <a href="/contacto" class="btn btn-outline">Contactar</a>
        </div>
      </div>
    </div>
  </main>
</Layout>
