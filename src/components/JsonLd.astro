---
export interface Props {
	title: string;
	description: string;
	canonicalURL: string;
	name?: string;
	givenName?: string;
	familyName?: string;
	affiliation?: string;
	email?: string;
	url?: string;
	sameAs?: string[];
	jobTitle?: string;
	knowsAbout?: string[];
}

const {
	title,
	description,
	canonicalURL,
	name = "Roberto Sánchez Reolid",
	givenName = "Roberto",
	familyName = "Sánchez Reolid",
	affiliation = "Universidad de Castilla-La Mancha",
	email = "roberto.sanchez@uclm.es",
	url = Astro.site?.href ?? "https://robertosanchezreolid.netlify.app",
	sameAs = [
		"https://scholar.google.com/citations?user=PCALePwAAAAJ",
		"https://orcid.org/0000-0003-4455-370X",
		"https://www.researchgate.net/profile/Roberto-Sanchez-Reolid",
		"https://www.linkedin.com/in/roberto-sanchez-reolid-phd-19215b4a/",
	],
	jobTitle = "Investigador y Profesor",
	knowsAbout = [
		"Inteligencia Artificial",
		"Machine Learning",
		"Procesamiento de Señales Fisiológicas",
		"Computación Afectiva",
		"Deep Learning",
		"IoT",
	],
} = Astro.props;
const personId = new URL('#person', url).href;
const websiteId = new URL('#website', url).href;
const pageId = `${canonicalURL}#webpage`;
const pathname = new URL(canonicalURL).pathname;
const isProfile = pathname === '/' || pathname === '/sobre-mi/';
const sectionNames: Record<string, string> = {
	'asignaturas': 'Docencia',
	'proyectos': 'Proyectos de investigación',
	'publicaciones': 'Publicaciones científicas',
	'cv': 'Currículum académico',
	'sobre-mi': 'Sobre mí',
	'contacto': 'Contacto',
	'privacidad': 'Política de privacidad',
};
const segments = pathname.split('/').filter(Boolean);
const breadcrumbs = [
	{ name: 'Inicio', item: new URL('/', url).href },
	...segments.map((segment, index) => ({
		name: sectionNames[segment] ?? title.replace(/\s+(?:-|\|)\s+(?:Dr\. )?Roberto Sánchez Reolid.*$/, ''),
		item: new URL(`/${segments.slice(0, index + 1).join('/')}/`, url).href,
	})),
];
const graph = [{
	"@type": "Person",
	"@id": personId,
	name,
	givenName,
	familyName,
	email,
	url,
	jobTitle,
	sameAs,
	affiliation: {
		"@type": "Organization",
		name: affiliation,
	},
	knowsAbout,
}, {
	'@type': 'WebSite',
	'@id': websiteId,
	url,
	name,
	inLanguage: 'es',
	publisher: { '@id': personId },
}, {
	'@type': isProfile ? 'ProfilePage' : pathname === '/contacto/' ? 'ContactPage' : 'WebPage',
	'@id': pageId,
	url: canonicalURL,
	name: title,
	description,
	inLanguage: 'es',
	isPartOf: { '@id': websiteId },
	about: { '@id': personId },
	...(isProfile ? { mainEntity: { '@id': personId } } : {}),
	...(segments.length ? { breadcrumb: { '@id': `${canonicalURL}#breadcrumb` } } : {}),
}, ...(segments.length ? [{
	'@type': 'BreadcrumbList',
	'@id': `${canonicalURL}#breadcrumb`,
	itemListElement: breadcrumbs.map((crumb, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		...crumb,
	})),
}] : [])];
// El contenido editorial nunca debe poder cerrar la etiqueta script.
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} />
