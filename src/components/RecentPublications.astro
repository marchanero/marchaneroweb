---
// Componente para mostrar publicaciones recientes
import type { Publication } from '../types/Scholar';

interface Props {
  publications: Publication[];
  limit?: number;
  showTitle?: boolean;
  title?: string;
}

const {
  publications,
  limit = 3,
  showTitle = true,
  title = "Publicaciones Recientes"
} = Astro.props;

const limitedPublications = publications.slice(0, limit);
---

<section class="py-0">
  {showTitle && (
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-8">
      <div>
        <p class="eyebrow mb-2">Google Scholar</p>
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-graphite-900 dark:text-white">
          {title}
        </h2>
      </div>
      <a href="/publicaciones" class="btn btn-outline btn-sm">Ver todas las publicaciones →</a>
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    {limitedPublications.map((publication) => (
      <article class="spec-card h-full flex flex-col">
        <span class="spec-tick spec-tick-tl"></span>
        <span class="spec-tick spec-tick-br"></span>

        <div class="flex items-center justify-between mb-4 font-mono text-xs">
          <span class="text-graphite-500 dark:text-graphite-400">{publication.year}</span>
          {publication.cited_by?.value > 0 && (
            <span class="text-pulse-600 dark:text-pulse-400">{publication.cited_by.value} citas</span>
          )}
        </div>

        <h3 class="text-base font-semibold text-graphite-900 dark:text-white mb-3 leading-snug line-clamp-3">
          {publication.link ? (
            <a href={publication.link} target="_blank" rel="noopener noreferrer" class="hover:text-pulse-600 dark:hover:text-pulse-400">
              {publication.title}
            </a>
          ) : (
            publication.title
          )}
        </h3>

        <p class="text-sm text-graphite-500 dark:text-graphite-400 line-clamp-2 mb-4">
          {publication.authors && typeof publication.authors === 'string'
            ? publication.authors.split(',').length > 2
              ? `${publication.authors.split(',')[0].trim()}, et al.`
              : publication.authors
            : 'Autores no disponibles'}
        </p>

        <div class="mt-auto pt-4 border-t border-line dark:border-line-dark">
          <p class="text-xs text-graphite-500 dark:text-graphite-400 line-clamp-2 mb-3">
            {publication.publication || 'Revista no especificada'}
          </p>
          {publication.link && (
            <a
              href={publication.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-pulse-600 dark:text-pulse-400 hover:text-pulse-700 dark:hover:text-pulse-300"
            >
              Leer publicación
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          )}
        </div>
      </article>
    ))}
  </div>

  {publications.length === 0 && (
    <div class="text-center py-16 border border-dashed border-line dark:border-line-dark rounded-md">
      <p class="text-graphite-600 dark:text-graphite-300 font-medium mb-1">No hay publicaciones disponibles</p>
      <p class="text-sm text-graphite-500 dark:text-graphite-400">Las publicaciones se actualizarán pronto.</p>
    </div>
  )}
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
